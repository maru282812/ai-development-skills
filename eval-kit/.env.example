# これは見本。コピーして `.env` を作り、実際のキーを入れる。
# `.env` は .gitignore 済み（Gitに上げない）。本物のキーをこの見本に書かないこと。
# 使うプロバイダの分だけ設定すればよい。

# 被験/JudgeがOpenAIのとき
OPENAI_API_KEY=sk-proj-xxxxxxxx
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_QUALITY=gpt-5.4

# 被験/JudgeがClaudeのとき
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 被験/JudgeがGemini(Google AI Studio)のとき
# GOOGLE_API_KEY=AIzaxxxxxxxx
